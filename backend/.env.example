# App Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=smartbite
DB_PASS=smartbite
DB_NAME=smartbite

# Prisma (optional if DB_* is provided)
DATABASE_URL=postgresql://smartbite:smartbite@127.0.0.1:5433/smartbite?schema=public

# Authentication & Security
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h

# CORS: use comma-separated deployed frontend origins in production, never "*" publicly
CORS_ORIGIN=http://localhost:8081

