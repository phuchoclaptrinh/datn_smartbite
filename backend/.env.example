# App Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=smartbite
DB_PASS=smartbite
DB_NAME=smartbite

# Prisma (optional if DB_* is provided)
DATABASE_URL=postgresql://smartbite:smartbite@127.0.0.1:5433/smartbite?schema=public

# Authentication & Security
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h

# Optional admin seed account
ADMIN_EMAIL=admin@smartbite.vn
ADMIN_PASSWORD=123456
ADMIN_FULL_NAME=Quản lý SmartBite

# CORS: use comma-separated deployed frontend origins in production, never "*" publicly
CORS_ORIGIN=http://localhost:8081

# Gemini AI for backend chatbot
GEMINI_API_KEY=
GEMINI_ENABLED=true
GEMINI_MODEL=gemini-2.5-flash
