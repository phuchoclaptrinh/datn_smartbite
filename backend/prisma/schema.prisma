generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FridgeUnit {
  g
  ml
  pcs
}

enum OrderStatus {
  Pending
  Preparing
  Delivering
  Completed
  Cancelled
}

enum UserRole {
  Customer
  Manager
}

enum InventoryMovementType {
  Import
  Export
  Adjustment
}

model User {
  id                String             @id @default(cuid())
  fullName          String
  email             String             @unique
  passwordHash      String             @default("")
  role              UserRole           @default(Customer)
  phone             String?
  tasteProfile      String[]
  allergies         String[]
  fridgeItems       FridgeItem[]
  orders            Order[]
  inventoryClosings InventoryClosing[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Ingredient {
  id             String                 @id @default(cuid())
  name           String                 @unique
  aliases        String[]
  normalizedName String?
  nameEn         String?
  category       String?
  isStockManaged Boolean                @default(true)
  stockQuantity  Int                    @default(0)
  unit           FridgeUnit             @default(pcs)
  minStock       Int                    @default(0)
  movements      InventoryMovement[]
  closingItems   InventoryClosingItem[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

model InventoryMovement {
  id            String                @id @default(cuid())
  ingredientId  String
  ingredient    Ingredient            @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  type          InventoryMovementType
  quantityDelta Int
  note          String?
  createdAt     DateTime              @default(now())

  @@index([ingredientId, createdAt])
  @@index([type, createdAt])
}

model InventoryClosing {
  id          String                 @id @default(cuid())
  closingDate DateTime               @unique @db.Date
  createdById String
  createdBy   User                   @relation(fields: [createdById], references: [id], onDelete: Restrict)
  note        String?
  items       InventoryClosingItem[]
  createdAt   DateTime               @default(now())

  @@index([createdById, closingDate])
}

model InventoryClosingItem {
  id               String           @id @default(cuid())
  closingId        String
  closing          InventoryClosing @relation(fields: [closingId], references: [id], onDelete: Cascade)
  ingredientId     String
  ingredient       Ingredient       @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  expectedQuantity Int
  actualQuantity   Int
  variance         Int
  unit             FridgeUnit

  @@unique([closingId, ingredientId])
  @@index([ingredientId])
}

model FridgeItem {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  quantity   Int
  unit       FridgeUnit
  expiryDate DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([userId, name])
}

model Recipe {
  id             String   @id @default(cuid())
  sourceId       String?  @unique
  name           String
  normalizedName String?
  category       String?
  description    String
  tags           String[]
  timeMin        Int
  servings       Int
  imageUrl       String?
  ingredients    Json
  steps          String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Order {
  id                String      @id @default(cuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items             Json
  subtotalAmount    Int
  deliveryFeeAmount Int
  totalAmount       Int
  currency          String      @default("VND")
  status            OrderStatus @default(Pending)
  note              String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([userId, createdAt])
}
